rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { return isSignedIn() && request.auth.token.role == 'admin'; }

    // Público: ler catálogo de missões
    match /missions/{missionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Leads: permitir criar lead (sem autenticar), mas só criar
    match /leads/{docId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Usuário: só ele pode ler/editar seus dados
    match /users/{uid} {
      allow read, update: if isOwner(uid);
      allow create: if isSignedIn();
      allow delete: if false;
    }

    // Progresso por missão
    match /userProgress/{uid}/missions/{missionId} {
      allow read, write: if isOwner(uid);
    }

    // Provas enviadas (metadados)
    match /userProofs/{uid}/missions/{missionId}/{proofId} {
      allow read, write: if isOwner(uid);
    }

    // Entitlements: somente admin
    match /entitlements/{email} {
      allow read, write: if isAdmin();
    }
  }
}
